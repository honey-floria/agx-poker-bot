+fn agx_deck(view: &AgxView) -> Result<[cards::Card; 52], String> {
+    if view.seat >= 6 || view.me.cards.len() != 2 || view.board.len() > 5 {
+        return Err("invalid seat, hole cards, or board length".to_string());
+    }
+    let mut deck = [u8::MAX; 52];
+    let mut used = [false; 52];
+    let mut place = |index: usize, text: &str| -> Result<(), String> {
+        let card = cards::parse_card(text).ok_or_else(|| format!("invalid card '{text}'"))?;
+        if used[card as usize] {
+            return Err(format!("duplicate card '{text}'"));
+        }
+        deck[index] = card;
+        used[card as usize] = true;
+        Ok(())
+    };
+    place(2 * view.seat, &view.me.cards[0])?;
+    place(2 * view.seat + 1, &view.me.cards[1])?;
+    for (offset, card) in view.board.iter().enumerate() {
+        place(12 + offset, card)?;
+    }
+    let mut remaining = (0u8..52).filter(|&card| !used[card as usize]);
+    for card in &mut deck {
+        if *card == u8::MAX {
+            *card = remaining.next().expect("52-card fill must be exact");
+        }
+    }
+    Ok(deck)
+}

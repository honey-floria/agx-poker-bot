+fn serve_agx(policy: &Policy, seed: u64) {
+    let stdin = std::io::stdin();
+    let mut stdout = std::io::BufWriter::new(std::io::stdout().lock());
+    writeln!(stdout, "{}", serde_json::json!({
+        "schema": "noregrets.agx-query-ready.v1", "ready": true
+    })).unwrap();
+    stdout.flush().unwrap();
+    for line in stdin.lock().lines() {
+        let line = match line {
+            Ok(line) => line,
+            Err(error) => {
+                writeln!(stdout, "{}", serde_json::json!({"ok": false, "error": error.to_string()})).unwrap();
+                stdout.flush().unwrap();
+                continue;
+            }
+        };
+        let parsed: Result<AgxQueryRequest, _> = serde_json::from_str(&line);
+        let response = match parsed {
+            Err(error) => serde_json::json!({"ok": false, "error": error.to_string()}),
+            Ok(request) => match agx_table(&request.view, policy) {
+                Err(error) => serde_json::json!({
+                    "request_id": request.request_id, "ok": false, "error": error
+                }),
+                Ok(table) => {
+                    let mut rng = SmallRng::seed_from_u64(
+                        seed ^ request.request_id.wrapping_mul(0x9E37_79B9_7F4A_7C15)
+                    );
+                    let (actions, probabilities) =
+                        policy.blueprint_dist(&table.shadow, &table.hist, &mut rng);
+                    let selected = cfr::sample_index(&probabilities, &mut rng);
+                    let action = actions[selected];
+                    let payload = match action {
+                        AbsAction::Fold => serde_json::json!({"type": "fold"}),
+                        AbsAction::CheckCall => serde_json::json!({
+                            "type": if table.real.can_check() { "check" } else { "call" }
+                        }),
+                        AbsAction::Bet(_) => match policy.abs.concrete(&table.real, action) {
+                            engine::PlayerAction::RaiseTo(target) => serde_json::json!({
+                                "type": if table.real.current_bet() == 0 { "bet" } else { "raise" },
+                                "to": target
+                            }),
+                            _ => unreachable!(),
+                        },
+                        AbsAction::AllIn => serde_json::json!({"type": "allin"}),
+                    };
+                    serde_json::json!({
+                        "request_id": request.request_id,
+                        "ok": true,
+                        "action": payload,
+                        "abstract_actions": actions.iter().map(|a| format!("{a:?}")).collect::<Vec<_>>(),
+                        "probabilities": probabilities
+                    })
+                }
+            },
+        };
+        writeln!(stdout, "{response}").unwrap();
+        stdout.flush().unwrap();
+    }
+}

+fn agx_table(view: &AgxView, policy: &Policy) -> Result<table::Table, String> {
+    if view.players.len() != 6 || view.button >= 6 {
+        return Err("AGX query requires six players and a valid button".to_string());
+    }
+    let cfg = HandConfig::default();
+    let mut table = table::Table::new(&cfg, view.button, agx_deck(view)?);
+    for action in &view.actions {
+        if table.real.is_terminal() || table.real.to_act() != action.seat {
+            return Err(format!(
+                "history actor mismatch: expected {}, got {}",
+                table.real.to_act(), action.seat
+            ));
+        }
+        let concrete = match action.kind.as_str() {
+            "fold" => engine::PlayerAction::Fold,
+            "check" | "call" => engine::PlayerAction::CheckCall,
+            "bet" | "raise" => engine::PlayerAction::RaiseTo(
+                action.to.ok_or_else(|| "raise/bet is missing 'to'".to_string())?,
+            ),
+            // An all-in can either be a raise or a short-stack call.  AGX records
+            // both forms as `allin`, while NoRegrets represents the latter as
+            // CheckCall because no legal raise interval exists.
+            "allin" => match table.real.raise_bounds() {
+                Some(bounds) => engine::PlayerAction::RaiseTo(bounds.1),
+                None if table.real.to_call() > 0 => engine::PlayerAction::CheckCall,
+                None => return Err("all-in is not legal in replay state".to_string()),
+            },
+            other => return Err(format!("unsupported history action '{other}'")),
+        };
+        table.apply_concrete(concrete, &policy.abs);
+    }
+    if table.real.is_terminal() || table.real.to_act() != view.seat {
+        return Err(format!(
+            "query actor mismatch: engine {}, view {}",
+            table.real.to_act(), view.seat
+        ));
+    }
+    let street = match table.real.street() {
+        engine::Street::Preflop => "preflop",
+        engine::Street::Flop => "flop",
+        engine::Street::Turn => "turn",
+        engine::Street::River => "river",
+    };
+    if street != view.street
+        || table.real.pot() != view.pot
+        || table.real.to_call() != view.to_call
+        || table.real.can_full_raise() != view.can_raise
+    {
+        return Err(format!(
+            "public state mismatch: engine {street}/pot {}/call {}/raise {}, view {}/pot {}/call {}/raise {}",
+            table.real.pot(), table.real.to_call(), table.real.can_full_raise(),
+            view.street, view.pot, view.to_call, view.can_raise
+        ));
+    }
+    for player in &view.players {
+        if player.seat >= 6
+            || table.real.stack(player.seat) != player.stack
+            || table.real.street_commit(player.seat) != player.bet
+            || table.real.hand_commit(player.seat) != player.invested
+            || table.real.folded(player.seat) != (player.state == "folded")
+            || table.real.all_in(player.seat) != (player.state == "allin")
+        {
+            return Err(format!("player {} snapshot mismatch", player.seat));
+        }
+    }
+    let actual_board: Vec<String> = table.real.board().iter().map(|&c| cards::card_str(c)).collect();
+    if actual_board != view.board {
+        return Err("board snapshot mismatch".to_string());
+    }
+    Ok(table)
+}

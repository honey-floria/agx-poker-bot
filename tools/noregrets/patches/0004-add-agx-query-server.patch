+    /// Whether the player to act can make at least a full minimum raise.
+    /// `raise_bounds` also returns a singleton interval for a short all-in;
+    /// AGX exposes that case as legal `allin` with `canRaise = false`.
+    pub fn can_full_raise(&self) -> bool {
